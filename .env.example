# Copy to .env.local and fill in. Never commit .env.local.

# ---- App ----
APP_BASE_URL="http://localhost:3000"
# Public tunnel URL (ngrok/cloudflared) once Track B needs webhooks.
# Recall.ai cannot reach localhost. Must match APP_BASE_URL in prod.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Auth0 (SDK v4 — NOT the v3 names in the PRD) ----
# Auth0 Dashboard > Applications > (Regular Web App)
# Allowed Callback URLs:  http://localhost:3000/auth/callback
# Allowed Logout URLs:    http://localhost:3000
AUTH0_DOMAIN="your-tenant.us.auth0.com"
AUTH0_CLIENT_ID=""
AUTH0_CLIENT_SECRET=""
# openssl rand -hex 32
AUTH0_SECRET=""

# ---- Supabase ----
# Settings > API. Service role key is server-only; never expose to the client.
SUPABASE_URL="https://xxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# ---- Stripe ----
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Test-mode customer id used for all metering in the demo.
STRIPE_DEMO_CUSTOMER_ID="cus_..."

# ---- Recall.ai ----
# Region-specific host. Check your dashboard: us-west-2 / us-east-1 / eu-central-1.
RECALL_API_BASE="https://us-west-2.recall.ai/api/v1"
RECALL_API_KEY=""
# Any random string. Verifies inbound webhooks are really from our bot.
RECALL_WEBHOOK_SECRET=""

# ---- OpenAI ----
OPENAI_API_KEY="sk-proj-..."

# ---- Jira ----
JIRA_HOST_NAME="your-domain.atlassian.net"
JIRA_USER_EMAIL=""
JIRA_API_TOKEN=""
JIRA_PROJECT_KEY="DEV"
# Must exist in the target project. Often "Task" instead of "Bug".
JIRA_ISSUE_TYPE="Task"
